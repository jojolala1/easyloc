{
  "name": "easyloc",
  "version": "2.0.0",
  "description": "API REST moderne pour la gestion de location de véhicules avec architecture SQL et NoSQL",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write src/",
    "docs": "jsdoc -c jsdoc.json"
  },
  "keywords": [
    "api",
    "rest",
    "mongodb",
    "sql-server",
    "location",
    "vehicules",
    "nodejs",
    "express",
    "mongoose"
  ],
  "author": "Votre Nom",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "mongoose": "^8.0.0",
    "mssql": "^11.0.1",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "express-rate-limit": "^7.1.5",
    "dotenv": "^16.3.1",
    "joi": "^17.11.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "jest": "^29.7.0",
    "supertest": "^6.3.3",
    "eslint": "^8.55.0",
    "prettier": "^3.1.0",
    "jsdoc": "^4.0.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/votre-username/easyloc.git"
  },
  "bugs": {
    "url": "https://github.com/votre-username/easyloc/issues"
  },
  "homepage": "https://github.com/votre-username/easyloc#readme"
}
